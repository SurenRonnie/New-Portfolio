# ─────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────

# ─── MongoDB ─────────────────────────────────────────────────────────────
# Atlas: Cluster > Connect > Drivers. Replace <db_password> with the real one.
# URL-encode special characters in the password (@ -> %40, # -> %23, % -> %25).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="portfolio"

# ─── SMTP (contact form email) ───────────────────────────────────────────
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification). A normal Gmail password will NOT work.
# Paste the 16 characters with NO spaces and NO dashes.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASS="abcdefghijklmnop"

# Gmail rewrites the From header unless it matches SMTP_USER.
MAIL_FROM="Your Name <your-gmail-address@gmail.com>"
# Where contact-form notifications are delivered.
MAIL_TO="your-inbox@gmail.com"

# ─── AI assistant (NVIDIA NIM) ───────────────────────────────────────────
# Get a key at https://build.nvidia.com
NVIDIA_API_KEY="nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Optional overrides — sensible defaults are set in lib/ai/graph.js
# NVIDIA_MODEL="openai/gpt-oss-120b"
# NVIDIA_FALLBACK_MODEL="nvidia/nemotron-3-super-120b-a12b"
